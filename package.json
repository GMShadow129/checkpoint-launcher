{
  "name": "checkpoint-launcher",
  "version": "0.5.1-beta.1",
  "description": "Launcher de Minecraft para la comunidad Checkpoint",
  "main": "main.js",
  "author": "GMShadow129",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/install-electron.js",
    "install:electron": "node scripts/install-electron.js",
    "build:dir": "electron-builder --dir",
    "build:win": "electron-builder --win nsis",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "msmc": "^5.0.5",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "googleapis": "^182.0.0",
    "adm-zip": "^0.5.16"
  },
  "build": {
    "appId": "com.checkpoint.launcher",
    "productName": "Checkpoint Launcher",
    "copyright": "Checkpoint Launcher",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "config/**/*",
      "package.json",
      "!**/node_modules/**/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/**/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/.bin"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon-512.png"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon-512.png",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Checkpoint Launcher",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "GMShadow129",
      "repo": "checkpoint-launcher",
      "releaseType": "release"
    }
  }
}